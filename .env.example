# Railway Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/thanksgiving
# Shared host passphrase
HOST_PASSPHRASE=change-me
# Random string used to sign the host session cookie (openssl rand -hex 32)
SESSION_SECRET=change-me
# Optional. Use 1 with the local PGlite server (npm run db:local)
# DB_POOL_MAX=1
